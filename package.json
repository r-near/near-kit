{
  "name": "@near-kit/monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "dev": "bun run --filter '*' dev",
    "test": "bun run --filter '*' test",
    "lint": "oxlint .",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "ci:version": "changeset version && bun update",
    "ci:publish": "bun run build && for dir in packages/*; do (cd \"$dir\" && PKG_NAME=$(jq -r .name package.json) && PKG_VERSION=$(jq -r .version package.json) && if npm view \"$PKG_NAME@$PKG_VERSION\" version 2>/dev/null; then echo \"$PKG_NAME@$PKG_VERSION already published, skipping\"; else bun pm pack && npm publish *.tgz --access public && rm *.tgz; fi); done && changeset tag",
    "release": "bun run ci:publish",
    "lefthook": "lefthook install",
    "prepare": "effect-tsgo patch --oxlint --no-force",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run build && bun run typecheck && bun run typecheck:consumers && bun run typecheck:examples && bun run typecheck:browser && bun run lint && bun run format:check",
    "typecheck:examples": "tsc --project examples/tsconfig.json",
    "typecheck:consumers": "tsc --project tests/types/tsconfig.json",
    "test:browser": "bun run build && playwright test",
    "test:browser:serve": "vite --config tests/browser/vite.config.ts",
    "typecheck:browser": "tsc --project tests/browser/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "0.47.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "lefthook": "^2.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dom18": "npm:react-dom@18.0.0",
    "react18": "npm:react@18.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2"
}
